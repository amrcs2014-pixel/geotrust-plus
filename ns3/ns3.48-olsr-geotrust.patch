+MprSet
+RoutingProtocol::RobustMprSet(const NeighborSet& N, const TwoHopNeighborSet& N2)
+{
+    // GeoTrust+ patch: lazy greedy on the submodular G_f(S) = sum_{|F|<=f} sum_u min(T_Fu, sum_{S\F} c)
+    // (f <= 1), same contributions/targets as GrrMprSet (Zhou Alg. 1), excluded neighbours removed,
+    // followed by reverse-delete pruning.  f comes from s_robustF (adaptive robustness).
+    MprSet S;
+    std::vector<Ipv4Address> g1, g2;
+    for (const auto& nb : N)
+    {
+        if (nb.willingness != Willingness::NEVER &&
+            !(s_mprExclude && s_mprExclude(m_mainAddress, nb.neighborMainAddr)))
+        {
+            g1.push_back(nb.neighborMainAddr);
+        }
+    }
+    for (const auto& t : N2)
+    {
+        if (std::find(g2.begin(), g2.end(), t.twoHopNeighborAddr) == g2.end())
+        {
+            g2.push_back(t.twoHopNeighborAddr);
+        }
+    }
+    if (g1.empty() || g2.empty())
+    {
+        return S;
+    }
+    const size_t n1 = g1.size(), k = g2.size();
+    auto clampP = [](double p) { return std::min(1.0, std::max(0.0, p)); };
+    std::vector<double> pu(n1);
+    for (size_t j = 0; j < n1; j++)
+    {
+        pu[j] = clampP(s_grrPlr(m_mainAddress, m_mainAddress, g1[j]));
+    }
+    std::vector<std::vector<double>> C(n1, std::vector<double>(k, 0.0));
+    for (const auto& t : N2)
+    {
+        size_t i = std::find(g2.begin(), g2.end(), t.twoHopNeighborAddr) - g2.begin();
+        size_t j = std::find(g1.begin(), g1.end(), t.neighborMainAddr) - g1.begin();
+        if (j == n1)
+        {
+            continue;
+        }
+        double pw = clampP(s_grrPlr(m_mainAddress, t.neighborMainAddr, t.twoHopNeighborAddr));
+        C[j][i] = std::max(C[j][i], -std::log(std::max(1e-9, pu[j] + (1.0 - pu[j]) * pw)));
+    }
+    uint32_t f = s_robustF ? std::min<uint32_t>(1, s_robustF(m_mainAddress)) : 0;
+    const size_t nF = f ? n1 + 1 : 1; // F = {} and F = {v}
+    std::vector<double> t(k), T(nF * k), cur(nF * k, 0.0);
+    for (size_t i = 0; i < k; i++)
+    {
+        double s = 0.0, mx = 0.0;
+        for (size_t j = 0; j < n1; j++)
+        {
+            s += C[j][i];
+            mx = std::max(mx, C[j][i]);
+        }
+        t[i] = std::max(0.0, (m_grrQmin == 1 ? mx : s) - std::log(m_grrGamma));
+    }
+    double goal = 0.0;
+    for (size_t F = 0; F < nF; F++)
+    {
+        for (size_t i = 0; i < k; i++)
+        {
+            double s = 0.0;
+            for (size_t j = 0; j < n1; j++)
+            {
+                if (F == 0 || j != F - 1)
+                {
+                    s += C[j][i];
+                }
+            }
+            T[F * k + i] = std::min(t[i], s);
+            goal += T[F * k + i];
+        }
+    }
+    auto gain = [&](size_t x) {
+        double g = 0.0;
+        for (size_t F = 0; F < nF; F++)
+        {
+            if (F && F - 1 == x)
+            {
+                continue;
+            }
+            for (size_t i = 0; i < k; i++)
+            {
+                double c0 = cur[F * k + i], tt = T[F * k + i];
+                if (c0 < tt)
+                {
+                    g += std::min(tt, c0 + C[x][i]) - c0;
+                }
+            }
+        }
+        return g;
+    };
+    std::vector<char> in(n1, 0);
+    std::vector<double> ub(n1, 1e300);
+    std::vector<size_t> sel;
+    double have = 0.0;
+    while (goal - have > 1e-7 * (goal + 1.0))
+    {
+        int best = -1;
+        for (;;)
+        {
+            int x = -1;
+            double top = -1.0, second = -1.0;
+            for (size_t y = 0; y < n1; y++)
+            {
+                if (in[y])
+                {
+                    continue;
+                }
+                if (ub[y] > top)
+                {
+                    second = top;
+                    top = ub[y];
+                    x = int(y);
+                }
+                else if (ub[y] > second)
+                {
+                    second = ub[y];
+                }
+            }
+            if (x < 0 || top <= 1e-12)
+            {
+                break;
+            }
+            ub[x] = gain(size_t(x));
+            if (ub[x] >= second)
+            {
+                if (ub[x] > 1e-12)
+                {
+                    best = x;
+                }
+                break;
+            }
+        }
+        if (best < 0)
+        {
+            break;
+        }
+        in[best] = 1;
+        sel.push_back(size_t(best));
+        have = 0.0;
+        for (size_t F = 0; F < nF; F++)
+        {
+            for (size_t i = 0; i < k; i++)
+            {
+                if (!(F && F - 1 == size_t(best)))
+                {
+                    cur[F * k + i] += C[best][i];
+                }
+                have += std::min(cur[F * k + i], T[F * k + i]);
+            }
+        }
+    }
+    for (int q = int(sel.size()) - 1; q >= 0; q--) // reverse-delete
+    {
+        size_t x = sel[q];
+        bool ok = true;
+        for (size_t F = 0; F < nF && ok; F++)
+        {
+            for (size_t i = 0; i < k && ok; i++)
+            {
+                double s = 0.0;
+                for (size_t v : sel)
+                {
+                    if (v != x && !(F && F - 1 == v))
+                    {
+                        s += C[v][i];
+                    }
+                }
+                ok = s >= T[F * k + i] - 1e-7;
+            }
+        }
+        if (ok)
+        {
+            sel.erase(sel.begin() + q);
+        }
+    }
+    for (size_t v : sel)
+    {
+        S.insert(g1[v]);
+    }
+    return S;
+}
