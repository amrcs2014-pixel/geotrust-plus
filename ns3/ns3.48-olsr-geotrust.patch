+void
+RoutingProtocol::ComputeDijkstraRoutes()
+{
+    // RangeGuard patch: minimum-cost routes over the same information OLSR already holds
+    // (symmetric neighbours, 2-hop tuples, topology tuples); only the metric changes.
+    struct Best
+    {
+        double cost;
+        Ipv4Address next;
+        Ipv4Address iface;
+        uint32_t hops;
+    };
+    using QItem = std::pair<double, Ipv4Address>;
+    auto cmp = [](const QItem& a, const QItem& b) { return a.first > b.first; };
+    std::priority_queue<QItem, std::vector<QItem>, decltype(cmp)> pq(cmp);
+    std::map<Ipv4Address, Best> best;
+    std::multimap<Ipv4Address, Ipv4Address> edges;
+
+    auto quarantined = [this](const Ipv4Address& a) {
+        return s_quarantine && s_quarantine(m_mainAddress, a);
+    };
+    for (const auto& nb : m_state.GetNeighbors())
+    {
+        if (nb.status != NeighborTuple::STATUS_SYM || quarantined(nb.neighborMainAddr))
+        {
+            continue;
+        }
+        const LinkTuple* lt = nullptr;
+        for (const auto& l : m_state.GetLinks())
+        {
+            if (GetMainAddress(l.neighborIfaceAddr) == nb.neighborMainAddr &&
+                l.time >= Simulator::Now())
+            {
+                lt = &l;
+                break;
+            }
+        }
+        if (!lt)
+        {
+            continue;
+        }
+        double c = s_linkCost(m_mainAddress, nb.neighborMainAddr);
+        best[nb.neighborMainAddr] = Best{c, lt->neighborIfaceAddr, lt->localIfaceAddr, 1};
+        pq.push({c, nb.neighborMainAddr});
+    }
+    for (const auto& t2 : m_state.GetTwoHopNeighbors())
+    {
+        if (t2.twoHopNeighborAddr != m_mainAddress)
+        {
+            edges.insert({t2.neighborMainAddr, t2.twoHopNeighborAddr});
+        }
+    }
+    for (const auto& tp : m_state.GetTopologySet())
+    {
+        if (tp.destAddr != m_mainAddress)
+        {
+            edges.insert({tp.lastAddr, tp.destAddr});
+        }
+    }
+
+    std::set<Ipv4Address> done;
+    while (!pq.empty())
+    {
+        auto [d, u] = pq.top();
+        pq.pop();
+        if (!done.insert(u).second)
+        {
+            continue;
+        }
+        Best bu = best[u];
+        auto range = edges.equal_range(u);
+        for (auto it = range.first; it != range.second; ++it)
+        {
+            const Ipv4Address& v = it->second;
+            if (v == m_mainAddress || done.count(v) || quarantined(v))
+            {
+                continue;
+            }
+            double nd = d + s_linkCost(u, v);
+            auto f = best.find(v);
+            if (f == best.end() || nd < f->second.cost - 1e-12)
+            {
+                best[v] = Best{nd, bu.next, bu.iface, bu.hops + 1};
+                pq.push({nd, v});
+            }
+        }
+    }
+    for (const auto& [dest, b] : best)
+    {
+        AddEntry(dest, b.next, b.iface, b.hops);
+    }
+}
