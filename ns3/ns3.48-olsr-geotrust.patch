+MprSet
+RoutingProtocol::GrrMprSet(const NeighborSet& N, const TwoHopNeighborSet& N2)
+{
+    // RangeGuard GRR patch: Zhou et al. (2026), Algorithm 1. Contribution of one-hop neighbour w to two-hop
+    // neighbour v: C[v][w] = -ln(P_uw + (1 - P_uw) P_wv) (0 if w does not reach v); target
+    // t_v = max(0, sum_w C[v][w] - ln gamma), i.e. the log form of prod_S(.) <= min(gamma * Q_min_v, 1).
+    MprSet S;
+    std::vector<Ipv4Address> g1;
+    for (const auto& nb : N)
+    {
+        if (nb.willingness != Willingness::NEVER)
+        {
+            g1.push_back(nb.neighborMainAddr);
+        }
+    }
+    std::vector<Ipv4Address> g2;
+    for (const auto& t : N2)
+    {
+        if (std::find(g2.begin(), g2.end(), t.twoHopNeighborAddr) == g2.end())
+        {
+            g2.push_back(t.twoHopNeighborAddr);
+        }
+    }
+    if (g1.empty() || g2.empty())
+    {
+        return S;
+    }
+    const size_t n1 = g1.size(), k = g2.size();
+    auto clampP = [](double p) { return std::min(1.0, std::max(0.0, p)); };
+    std::vector<double> pu(n1);
+    for (size_t j = 0; j < n1; j++)
+    {
+        pu[j] = clampP(s_grrPlr(m_mainAddress, m_mainAddress, g1[j]));
+    }
+    std::vector<std::vector<double>> C(k, std::vector<double>(n1, 0.0));
+    for (const auto& t : N2)
+    {
+        size_t i = std::find(g2.begin(), g2.end(), t.twoHopNeighborAddr) - g2.begin();
+        size_t j = std::find(g1.begin(), g1.end(), t.neighborMainAddr) - g1.begin();
+        if (j == n1)
+        {
+            continue;
+        }
+        double pw = clampP(s_grrPlr(m_mainAddress, t.neighborMainAddr, t.twoHopNeighborAddr));
+        double term = std::max(1e-9, pu[j] + (1.0 - pu[j]) * pw);
+        C[i][j] = std::max(C[i][j], -std::log(term));
+    }
+    std::vector<double> tgt(k);
+    std::vector<std::vector<size_t>> R(k);
+    for (size_t i = 0; i < k; i++)
+    {
+        double s = 0.0, mx = 0.0;
+        for (size_t j = 0; j < n1; j++)
+        {
+            s += C[i][j];
+            mx = std::max(mx, C[i][j]);
+        }
+        // GeoTrust+ patch: GrrQmin 0 = Q_min over all relays (RangeGuard port), 1 = best single relay
+        tgt[i] = std::max(0.0, (m_grrQmin == 1 ? mx : s) - std::log(m_grrGamma));
+        if (m_grrAbs > 0.0)
+        {
+            tgt[i] = std::min(tgt[i], -std::log(m_grrAbs)); // absolute-target variant: max(gamma Q_min, target)
+        }
+        R[i].resize(n1);
+        std::iota(R[i].begin(), R[i].end(), size_t(0));
+        std::stable_sort(R[i].begin(), R[i].end(), [&](size_t a, size_t b) { return C[i][a] > C[i][b]; });
+    }
+    std::vector<char> in(n1, 0);
+    std::vector<double> acc(k, 0.0);
+    auto satisfied = [&]() {
+        for (size_t i = 0; i < k; i++)
+        {
+            if (acc[i] + 1e-9 < tgt[i])
+            {
+                return false;
+            }
+        }
+        return true;
+    };
+    for (size_t r = 0; r < n1; r++)
+    {
+        for (size_t i = 0; i < k; i++)
+        {
+            size_t j = R[i][r];
+            if (in[j] || C[i][j] <= 0.0)
+            {
+                continue;
+            }
+            in[j] = 1;
+            S.insert(g1[j]);
+            for (size_t q = 0; q < k; q++)
+            {
+                acc[q] += C[q][j];
+            }
+            if (satisfied())
+            {
+                return S;
+            }
+        }
+    }
+    return S;
+}
